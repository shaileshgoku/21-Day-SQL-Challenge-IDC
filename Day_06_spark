import pyspark.sql.functions as F

# Question: For each hospital service, calculate the total number of patients admitted,
# total patients refused, and the admission rate (percentage of requests that were admitted).
# Order by admission rate descending.


services_weekly_df.groupBy('service').agg(
    F.sum('patients_admitted').alias('total_admitted'),
    F.sum('patients_refused').alias('total_refused'),
    F.round(
        (F.sum('patients_admitted') * 100.0) / F.sum('patients_request'),
        2
    ).alias('admission_rate')
).orderBy('admission_rate', ascending=False).show()

+----------------+--------------+-------------+--------------+
|         service|total_admitted|total_refused|admission_rate|
+----------------+--------------+-------------+--------------+
|             ICU|           648|          141|         82.13|
|         surgery|          1686|          555|         75.23|
|general_medicine|          2332|         1938|         54.61|
|       emergency|          1185|         5008|         19.13|
+----------------+--------------+-------------+--------------+

