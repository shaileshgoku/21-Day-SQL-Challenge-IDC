# Question: Calculate the average length of stay (in days) for each service,
# showing only services where the average stay is more than 7 days.
# Also show the count of patients and order by average stay descending.

from pyspark.sql.functions import col

patients_df \
    .withColumn(
        "length_of_stay",
        F.datediff("departure_date", "arrival_date")
    ) \
    .groupBy("service") \
    .agg(
        F.count("*").alias("patients_count"),
        F.avg("length_of_stay").alias("avg_stay_length")
    ) \
    .filter(
        F.col("avg_stay_length") > 7
    ) \
    .orderBy(
        F.col("avg_stay_length").desc()
    ) \
    .show()

